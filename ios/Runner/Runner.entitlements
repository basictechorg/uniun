<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Inbound share: shared App Group container the Share Extension writes
	     into and the host app reads from (receive_sharing_intent). Must match
	     the value on ShareExtension.entitlements. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.in.uniun.app</string>
	</array>
	<!-- Universal links. Requires
	     https://www.uniun.in/.well-known/apple-app-site-association
	     listing this app's <TeamID>.<bundleId> and the matched paths. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:www.uniun.in</string>
	</array>
	<!-- flutter_gemma: large on-device LLMs (Gemma 4 E2B/E4B) need expanded
	     virtual addressing + raised memory limits, or the compiled model fails
	     to invoke on device. Required by the flutter_gemma 1.0 iOS setup.
	     NOTE: com.apple.developer.kernel.increased-debugging-memory-limit is
	     intentionally NOT declared here. It is a restricted entitlement that
	     Apple does not include in the auto-managed provisioning profile, so
	     signing fails with "isn't permitted on the Runner.app bundle". It only
	     raises the memory ceiling while attached to the Xcode debugger and has
	     no effect on production; increased-memory-limit below covers real use. -->
	<key>com.apple.developer.kernel.extended-virtual-addressing</key>
	<true/>
	<key>com.apple.developer.kernel.increased-memory-limit</key>
	<true/>
</dict>
</plist>
